{
  "name": "@arrosticini/infra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "bootstrap": "cdk bootstrap",
    "foundation:deploy": "cdk deploy arrosticini-foundation",
    "foundation:destroy": "cdk destroy arrosticini-foundation",
    "app:deploy": "cdk deploy arrosticini-app",
    "app:destroy": "cdk destroy arrosticini-app arrosticini-waf",
    "dns:update": "tsx scripts/dns.ts update",
    "dns:delete": "tsx scripts/dns.ts delete",
    "app:api:restart": "aws ecs update-service --region eu-south-1 --cluster arrosticini-cluster --service api --force-new-deployment",
    "app:web:restart": "aws ecs update-service --region eu-south-1 --cluster arrosticini-cluster --service web --force-new-deployment"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "catalog:",
    "@aws-sdk/client-ecr": "catalog:",
    "@aws-sdk/client-ssm": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:"
  },
  "devDependencies": {
    "@arrosticini/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "aws-cdk": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
