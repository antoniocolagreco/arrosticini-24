{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["biome.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {
      "context": {
        "dependencies": {
          "deny": ["context", "app"]
        }
      },
      "kernel": {
        "dependencies": {
          "deny": ["context", "app"]
        }
      }
    }
  }
}
