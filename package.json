{
  "name": "arrosticini-24",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=16",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundaries": "turbo boundaries",
    "local:up": "docker compose up -d --wait valkey dynamodb s3 && turbo run setup:local",
    "local:stop": "docker compose stop",
    "local:destroy": "docker compose down -v",
    "local:reset": "pnpm local:destroy && pnpm local:up",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
