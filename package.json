{
  "name": "arrosticini-24",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=16",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundaries": "turbo boundaries",
    "local:up": "docker compose up -d --wait valkey dynamodb s3 && turbo run setup:local",
    "local:stop": "docker compose stop",
    "local:destroy": "docker compose down -v",
    "local:reset": "pnpm local:destroy && pnpm local:up",
    "aws:bootstrap": "pnpm --filter @arrosticini/infra bootstrap",
    "aws:foundation:deploy": "pnpm --filter @arrosticini/infra foundation:deploy",
    "aws:foundation:destroy": "pnpm --filter @arrosticini/infra foundation:destroy",
    "aws:app:deploy": "pnpm --filter @arrosticini/infra app:deploy && pnpm aws:dns:update",
    "aws:dns:update": "pnpm --filter @arrosticini/infra dns:update",
    "aws:dns:delete": "pnpm --filter @arrosticini/infra dns:delete",
    "aws:app:seed": "pnpm --filter @arrosticini/api seed:aws",
    "aws:app:destroy": "pnpm --filter @arrosticini/infra app:destroy && pnpm aws:dns:delete",
    "aws:app:api:restart": "pnpm --filter @arrosticini/infra app:api:restart",
    "aws:app:web:restart": "pnpm --filter @arrosticini/infra app:web:restart",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
