{
  "name": "@arrosticini/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "start": "node dist/server.js",
    "setup:local": "tsx --env-file-if-exists=../../.env.local scripts/setup-local.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@arrosticini/catalog": "workspace:*",
    "@arrosticini/contracts": "workspace:*",
    "@arrosticini/identity": "workspace:*",
    "@arrosticini/kernel": "workspace:*",
    "@arrosticini/ops": "workspace:*",
    "@arrosticini/ordering": "workspace:*",
    "@arrosticini/payments": "workspace:*",
    "@arrosticini/shopping": "workspace:*",
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "express": "catalog:",
    "iovalkey": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arrosticini/testing": "workspace:*",
    "@arrosticini/tsconfig": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
