{
  "extends": "@arrosticini/tsconfig/base.json",
  "include": ["app", "server.ts", "server", "*.ts", ".react-router/types"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": { "~/*": ["./app/*"] }
  }
}
