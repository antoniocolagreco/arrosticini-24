    "lint": "biome check .",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arrosticini/tsconfig": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/zod": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
